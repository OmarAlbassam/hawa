# Benchmark imports the LLM service's Settings; only LLM_API_KEY is required.
# Everything else (provider, model, temperature, rate limits) is set per
# experiment in the YAML or auto-probed at runtime.

LLM_API_KEY=

# Token caps applied to every request. Lowering MAX_TOKENS frees the rate
# limiter's per-request reservation; the JSON output is always <80 tokens.
LLM_MAX_TOKENS=80
LLM_MAX_TEXT_LENGTH=512

# Rate-limit budgets are auto-discovered from x-ratelimit-* response headers.
# Override here only if you want to throttle BELOW the provider's ceiling.
# LLM_RATE_RPM=
# LLM_RATE_TPM=
