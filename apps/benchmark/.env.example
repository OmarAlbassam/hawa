# Benchmark imports the LLM service's Settings, so use the same LLM_* env vars.
# See apps/llm/.env.example for the full list. Common ones for benchmarking:

LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# Rate budget for the experiment. Defaults to provider-discovered values.
LLM_RATE_RPM=28
LLM_RATE_TPM=5800

# Benchmark paths and embedder model are passed via CLI flags (see
# `benchmark embed --help` / `benchmark run --help`) — keeping them out of
# the .env file keeps experiment configuration in one place (the YAML).
