# Benchmark imports the LLM service's Settings.
#
# Required:
#   LLM_API_KEY        — provider key (Groq or RunPod)
#
# Required for RunPod (per-endpoint URL, no default). Pick one form:
#   Serverless: https://api.runpod.ai/v2/<endpoint-id>/openai/v1
#   Pod proxy:  https://<pod-id>-8000.proxy.runpod.net/v1
#   LLM_PROVIDER=runpod
#   LLM_BASE_URL=<one of the above>
#   LLM_API_KEY=<runpod api key for serverless, or vllm --api-key for pod>
#   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct      # or whatever the worker serves
#
# For Groq, leave LLM_PROVIDER and LLM_BASE_URL unset; provider/model are
# selected per-experiment in the YAML.

LLM_API_KEY=

# RunPod (uncomment to enable)
# LLM_PROVIDER=runpod
# LLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Token caps applied to every request. Lowering MAX_TOKENS frees the rate
# limiter's per-request reservation; the JSON output is always <80 tokens.
LLM_MAX_TOKENS=80
LLM_MAX_TEXT_LENGTH=512

# Rate-limit budgets are auto-discovered from x-ratelimit-* response headers
# (Groq). Self-hosted backends (Ollama, RunPod) skip the probe — capacity is
# bounded by GPU/worker, not provider quota. Override here only to throttle
# BELOW the provider's ceiling.
# LLM_RATE_RPM=
# LLM_RATE_TPM=
