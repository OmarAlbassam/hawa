# Provider: "ollama" (default, local dev), "runpod" (production), or "groq"
LLM_PROVIDER=ollama

# --- Ollama defaults (no config needed for local dev) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

# --- RunPod (uncomment for production) ---
# LLM_PROVIDER=runpod
# Serverless: https://api.runpod.ai/v2/<endpoint-id>/openai/v1
# Pod proxy:  https://<pod-id>-8000.proxy.runpod.net/v1
# LLM_BASE_URL=
# LLM_API_KEY=<runpod api key for serverless, or vllm --api-key for pod>
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Groq (uncomment for hosted Groq) ---
# LLM_PROVIDER=groq
# LLM_API_KEY=<your-groq-api-key>
# Provider defaults set RPM=28, TPM=5800 for the free llama-3.1-8b-instant tier.

# Service
LLM_PORT=8001
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512

# Rate limiting (0 = unlimited; provider-specific defaults apply if unset).
# With auto-discovery on (default), the service reads x-ratelimit-* headers
# at startup and overrides these values for hosted providers.
# LLM_RATE_RPM=28
# LLM_RATE_TPM=5800
# LLM_MAX_CONCURRENCY=3
# LLM_RATE_MAX_RETRIES=5
# LLM_RATE_INITIAL_BACKOFF_S=5.0
# LLM_RATE_MAX_BACKOFF_S=60.0
# Pause duration applied after a 429: max(RATE_MIN_PAUSE_S, Retry-After * RATE_PAUSE_PADDING).
# The floor prevents queued workers from all racing through a 1–2s "single-request refill"
# window and re-triggering the limit.
# LLM_RATE_MIN_PAUSE_S=5.0
# LLM_RATE_PAUSE_PADDING=1.25
# LLM_AUTO_DISCOVER_LIMITS=true
# LLM_RATE_SAFETY_MARGIN=0.9

# HTTP timeouts (per-provider defaults: groq=60s, ollama=300s, runpod=600s).
# RunPod serverless cold starts can take 30-90s before the first token; 60s
# would surface as APITimeoutError on a cold worker.
# LLM_REQUEST_TIMEOUT_S=60.0
# LLM_CONNECT_TIMEOUT_S=10.0
