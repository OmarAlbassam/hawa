# Provider: "ollama" (default, local dev) or "runpod" (production)
LLM_PROVIDER=ollama

# --- Ollama defaults (no config needed for local dev) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

# --- RunPod (uncomment for production) ---
# LLM_PROVIDER=runpod
# LLM_BASE_URL=https://api.runpod.ai/v2/<pod-id>/openai/v1
# LLM_API_KEY=<your-runpod-api-key>
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Service
LLM_PORT=8001
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
